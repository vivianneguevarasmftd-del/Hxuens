:${PORT} {
    # Отдача клиентского JSON-конфига sing-box
    handle /sub/${SUB_PATH} {
        header Content-Type "application/json; charset=utf-8"
        file_server {
            root /app/public
        }
        rewrite * /config.json
    }

    # Проброс VLESS WebSocket в локальный Xray
    handle ${WSPATH}* {
        reverse_proxy 127.0.0.1:10000
    }

    # Заглушка для всех остальных путей
    handle {
        respond "OK" 200
    }
}
